{
  "name": "weapplyjobs-backend-service",
  "version": "1.0.0",
  "description": "WeApplyJobs backend service for application submissions and async queue processing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node --esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:queue": "ts-node --esm src/scripts/test-queue.ts",
    "seed:db": "ts-node --esm src/scripts/seed-db.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": ["fastify", "bullmq", "redis", "async-queue", "applications"],
  "author": "sriramulaganesh375@gmail.com",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "axios": "^1.6.5",
    "bullmq": "^5.8.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "fastify-cors": "^9.0.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "redis": "^4.6.13",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
